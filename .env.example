# Заполните локально; секреты не хранить в Git.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Для локального Python; Compose переопределяет хост на db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
WEB_PORT=
# Необязательны: Basic Auth включён, только если заполнены оба поля.
WEB_USER=
WEB_PASSWORD=
# Независимые переключатели для Python и Compose, по умолчанию выключены.
DOCS_ENABLED=false
LIST_ENDPOINT_ENABLED=false
# Ограничение размера загружаемого XLSX-файла, по умолчанию 10 МБ.
# MAX_EXCEL_SIZE_BYTES=10485760

# Локальный Python: пути к публичному реестру и доступному для записи кэшу КР.
# Для Compose используйте docker-compose.rag.yml: он задаёт пути внутри контейнера.
# AI_REGISTRY_PATH=C:/rag-data/grls/registry.json
# AI_CLINICAL_CACHE_DIR=C:/rag-data/clinicalrecs
# AI_LIVE_SOURCES=true
# AI_MODE=network
# API_BUILD_TARGET=ai-network
# AI_PAIR_TIMEOUT_SECONDS=120
# AI_APPLICATION_TIMEOUT_SECONDS=240
# Необязательные пути ХОСТА для bind mounts (иначе ./.local/rag-data/...).
# RAG_REGISTRY_SOURCE=C:/rag-data/grls/registry.json
# RAG_CACHE_SOURCE=C:/rag-data/clinicalrecs
# Ключ GIGACHAT_CREDENTIALS задавайте только локально, не публикуйте его значение.
