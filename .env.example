# Заполните локально; секреты не хранить в Git.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Для локального Python; Compose переопределяет хост на db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
WEB_PORT=
# Необязательны: Basic Auth включён, только если заполнены оба поля.
WEB_USER=
WEB_PASSWORD=
# Независимые переключатели для Python и Compose, по умолчанию выключены.
DOCS_ENABLED=false
LIST_ENDPOINT_ENABLED=false
# Ограничение размера загружаемого XLSX-файла, по умолчанию 10 МБ.
# MAX_EXCEL_SIZE_BYTES=10485760
