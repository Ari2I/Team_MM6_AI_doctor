# Заполните локально; секреты не хранить в Git.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Для локального Python; Compose переопределяет хост на db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
WEB_PORT=
WEB_USER=
WEB_PASSWORD=
# Только локальный Python; Compose принудительно выключает эти возможности.
ENABLE_API_DOCS=true
ENABLE_APPLICATION_LIST=true
# Ограничение размера загружаемого XLSX-файла, по умолчанию 10 МБ.
# MAX_EXCEL_SIZE_BYTES=10485760
