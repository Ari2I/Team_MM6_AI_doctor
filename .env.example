# Пример для локальной разработки; замените пароль в своей .env.
POSTGRES_DB=vrach
POSTGRES_USER=vrach
POSTGRES_PASSWORD=local_dev_password
# Для локального Python; Compose переопределяет хост на db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
API_PORT=8000
# Ограничение размера загружаемого XLSX-файла, по умолчанию 10 МБ.
# MAX_EXCEL_SIZE_BYTES=10485760

